# ====== Ikat by Malika Shakirova ======
# Shu faylni ".env" nomi bilan nusxalang. Render'da har bir qatorni Environment bo'limiga kiriting.
# Haqiqiy kalitlarni BU faylga yozmang (u GitHub'ga chiqadi).

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SECRET_KEY

# @BotFather bergan token
BOT_TOKEN=

# Saytning HTTPS manzili. Render'da bo'sh qolsa ham bo'ladi (avtomatik aniqlanadi)
PUBLIC_URL=

# Admin paroli (admin akkaunti birinchi marta yaratilganda ishlatiladi)
ADMIN_PASSWORD=

# Ixtiyoriy: tokenlar uchun uzun tasodifiy matn
SECRET=

# Eski nomlar ham ishlaydi:
#   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, ADMIN_CHAT_ID
